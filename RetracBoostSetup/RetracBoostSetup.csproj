<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RetracBoost-Setup</AssemblyName>
    <RootNamespace>RetracBoostSetup</RootNamespace>
    <Product>Retrac Boost Custom Setup</Product>
    <Version>1.0.7</Version>
    <StartupObject>RetracBoostSetup.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\RetracBoost\app.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\RetracBoost\bin\RetracBoost.exe" LogicalName="Payload.RetracBoost.exe" />
    <EmbeddedResource Include="..\README.md" LogicalName="Payload.README.md" />
    <EmbeddedResource Include="..\RetracBoost\app.ico" LogicalName="Payload.app.ico" />
  </ItemGroup>

</Project>
