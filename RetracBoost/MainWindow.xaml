<Window x:Class="RetracBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retrac Boost" Width="1000" Height="740" MinWidth="940" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D12" Foreground="#E9ECF2"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0A0D14"/>
        <SolidColorBrush x:Key="Surface" Color="#111520"/>
        <SolidColorBrush x:Key="Raised" Color="#161C2B"/>
        <SolidColorBrush x:Key="Hover" Color="#1E263A"/>
        <SolidColorBrush x:Key="Line" Color="#202738"/>
        <SolidColorBrush x:Key="LineStrong" Color="#2D3850"/>
        <SolidColorBrush x:Key="Text" Color="#F0F3F9"/>
        <SolidColorBrush x:Key="Muted" Color="#8B94A7"/>
        <SolidColorBrush x:Key="Accent" Color="#00F5A0"/>
        <SolidColorBrush x:Key="AccentInk" Color="#032517"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#0E2D22"/>
        <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
        <SolidColorBrush x:Key="Bad" Color="#F87171"/>
        <SolidColorBrush x:Key="BarIdle" Color="#333E56"/>

        <!-- Eleganter leuchtender Statuspunkt (Static Glow, 0.0% CPU) -->
        <Style x:Key="PulsingDot" TargetType="Ellipse">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00F5A0" BlurRadius="6" ShadowDepth="0" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schmale dunkle Scrollleiste -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{StaticResource LineStrong}" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schalter mit echter Federungs-Animation (BackEase Bounce) & Glow -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="25" Background="Transparent">
                            <!-- Track (Hintergrund) -->
                            <Border x:Name="Track" CornerRadius="12.5" Background="#1D2433" BorderBrush="#2A354A" BorderThickness="1"/>

                            <!-- Thumb (Schieber mit Federungs-Animation) -->
                            <Border x:Name="Thumb" Width="19" Height="19" Margin="3,0,0,0" HorizontalAlignment="Left"
                                    CornerRadius="9.5" Background="#8E9CB2">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="Shift" X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00F5A0" Offset="0"/>
                                            <GradientStop Color="#00D287" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00F5A0"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Track" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F5A0" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="21" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.32" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.32" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#495B7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hauptknopf mit Cyber-Emerald Glow & Micro-Interactions -->
        <Style x:Key="BoostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="13" Height="50" BorderBrush="Transparent" BorderThickness="1.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" CenterX="150" CenterY="25" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00F5A0" Offset="0"/>
                                    <GradientStop Color="#00D287" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#00F5A0" BlurRadius="22" ShadowDepth="2" Direction="270" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="Bold" TextElement.FontSize="15"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.96"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.975" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.975" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0F2820" Offset="0"/>
                                            <GradientStop Color="#091A14" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00F5A0"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#00F5A0"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F5A0" BlurRadius="24" ShadowDepth="0" Direction="270" Opacity="0.32"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sekundärknopf in Karten -->
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,8" Background="{StaticResource Raised}"
                                BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kleiner Textknopf -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zielauswahl -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,8" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Tabs mit sauberem Kapsel-Indikator -->
        <Style x:Key="ModernTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E97AB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="9" Padding="20,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="13" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2333"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242E42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#384766"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tab" BasedOn="{StaticResource ModernTab}" TargetType="RadioButton"/>

        <!-- Auto-Updater Pill Button -->
        <Style x:Key="UpdatePill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,7" Background="#141926"
                                BorderBrush="#263147" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00F5A0"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1B2233"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,7" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PopupItem}"/>
        </Style>

        <Style x:Key="PopupBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Balken in Ergebnislisten -->
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BarIdle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{StaticResource Line}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kartenstil mit modernem Glassmorphismus & Schatten -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#141824" Offset="0"/>
                        <GradientStop Color="#0F131D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#242C3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.38"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <DataTemplate x:Key="TargetItem">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="13"/>
                <TextBlock Text="{Binding Host}" FontSize="11" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GameItem">
            <StackPanel>
                <TextBlock Text="{Binding Exe}" FontSize="13"/>
                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PotatoItem">
            <StackPanel Background="Transparent" PreviewMouseLeftButtonUp="PotatoItem_Click">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Info}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- Zeile eines Tweaks mit Hover-Highlight & leuchtendem Indikator -->
        <DataTemplate x:Key="RowTemplate">
            <Border x:Name="RowBd" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,10"
                    CornerRadius="10" Background="Transparent" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Neon-Akzentbalken bei Hover -->
                    <Border x:Name="HoverBar" Width="3" Height="18" CornerRadius="1.5" Background="#00F5A0"
                            Margin="0,0,10,0" Opacity="0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Ghost}" Content="{Binding ActionText}"
                                Visibility="{Binding ActionVisibility}" Click="Action_Click" Margin="0,0,8,0"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                  IsEnabled="{Binding CanToggle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Hover}"/>
                    <Setter TargetName="HoverBar" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Zeile mit Balken (Regionstest) -->
        <DataTemplate x:Key="BarRowTemplate">
            <Border Padding="0,5" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ListRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Left}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Value="{Binding Fraction}"
                                 Foreground="{Binding BarBrush}" Margin="10,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Right}" HorizontalAlignment="Right"/>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dim}" Value="True">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!-- Zeile einer Route -->
        <DataTemplate x:Key="HopRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Left}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Middle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Middle}"/>
                <TextBlock Grid.Column="2" Text="{Binding Right}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="{Binding Extra}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#0A0D14">
        <!-- Ambient Vibrant Lighting Orbs (Lebendig & Clean) -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <!-- Top-Left Neon Emerald Atmosphere Glow -->
            <Ellipse Width="650" Height="450" Canvas.Left="-180" Canvas.Top="-160" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#00F5A0" Offset="0"/>
                        <GradientStop Color="#00B875" Offset="0.45"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Top-Right Cyber Cyan / Blue Accent Glow -->
            <Ellipse Width="600" Height="420" Canvas.Right="-160" Canvas.Top="-80" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#38BDF8" Offset="0"/>
                        <GradientStop Color="#6366F1" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Bottom Subtle Deep Glow -->
            <Ellipse Width="550" Height="320" Canvas.Left="200" Canvas.Bottom="-120" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#10B981" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Main Workspace -->
        <Grid Margin="34,16,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Modern Header Bar ===== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Version Pill -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#00F5A0" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <Path Data="M7,16 L12,8 L16,14 L23,5" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RETRAC" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text=" BOOST" FontSize="15" FontWeight="Normal" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <Border Background="#161D2B" BorderBrush="#2A374F" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderVersionBadge" Text="v1.0.1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                    </Border>
                </StackPanel>

                <!-- Segmented Capsule Tabs (Center) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#121622" BorderBrush="#232C3D" BorderThickness="1" CornerRadius="12" Padding="3">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabBoost" Style="{StaticResource ModernTab}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabTools" Style="{StaticResource ModernTab}" GroupName="tabs" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabRetrac" Style="{StaticResource ModernTab}" GroupName="tabs" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Right Controls: Auto-Updater Pill Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateBadgeButton" Style="{StaticResource UpdatePill}" Click="UpdateBadge_Click" ToolTip="Klicken für Updates &amp; Changelog">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="UpdateDot" Style="{StaticResource PulsingDot}" Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UpdateBadgeText" Text="Aktuell (v1.0.1)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Seite 1: Boost ================= -->
            <Grid x:Name="PageBoost" Grid.Row="1">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageBoostTrans" Y="0"/>
                </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TargetButton" Style="{StaticResource Pill}" Click="TargetButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TargetText" FontSize="13"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Muted}" StrokeThickness="1.6"
                                  Margin="12,2,0,0" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ModeText" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,26,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PingValue" Text="–" FontSize="92" FontWeight="Light" LineHeight="96" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="PingUnit" Text="ms" FontSize="22" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,2,0,0">
                        <Ellipse x:Name="QualityDot" Style="{StaticResource PulsingDot}" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QualityText" Foreground="{StaticResource Muted}" Margin="9,0,0,0" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="GraphHost" Grid.Row="2" Margin="0,26,0,22" MinHeight="120"/>

                <UniformGrid Grid.Row="3" Columns="4">
                    <StackPanel>
                        <TextBlock x:Name="LabelAvg" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatAvg" Style="{StaticResource StatValue}" Text="–"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="LabelJitter" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatJitter" Style="{StaticResource StatValue}" Text="–"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="LabelLoss" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatLoss" Style="{StaticResource StatValue}" Text="–"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="LabelMax" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatMax" Style="{StaticResource StatValue}" Text="–"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,22,22,18" CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button x:Name="BoostButton" Style="{StaticResource BoostButton}" Click="BoostButton_Click"/>
                        <TextBlock x:Name="BoostHint" Foreground="{StaticResource Muted}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,14,-8,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="RowList" Margin="0,0,8,0" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="CompareText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="AdminText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Warn}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Seite 2: Werkzeuge ================= -->
        <ScrollViewer x:Name="PageTools" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      Focusable="False" Margin="0,0,-12,0">
            <ScrollViewer.RenderTransform>
                <TranslateTransform x:Name="PageToolsTrans" Y="0"/>
            </ScrollViewer.RenderTransform>
            <Grid Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Beste Region -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="RegionTitle" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="RegionDesc" Style="{StaticResource CardDesc}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="RegionRun" Style="{StaticResource Action}" Click="RegionRun_Click"/>
                            <TextBlock x:Name="RegionStatus" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" Margin="0,10,-8,0" Focusable="False">
                            <ItemsControl x:Name="RegionList" ItemTemplate="{StaticResource BarRowTemplate}" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Verbindungs-Diagnose -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="RouteTitle" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="RouteDesc" Style="{StaticResource CardDesc}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="RouteRun" Style="{StaticResource Action}" Click="RouteRun_Click"/>
                            <TextBlock x:Name="RouteStatus" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="RouteSummary" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Margin="0,8,-8,0" Focusable="False">
                            <ItemsControl x:Name="RouteList" ItemTemplate="{StaticResource HopRowTemplate}" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Ping unter Last -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="LoadTitle" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="LoadDesc" Style="{StaticResource CardDesc}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="LoadRun" Style="{StaticResource Action}" Click="LoadRun_Click"/>
                            <TextBlock x:Name="LoadStatus" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LoadLabelIdle" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="LoadIdle" Style="{StaticResource StatValue}" Text="–"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="LoadLabelDown" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="LoadDown" Style="{StaticResource StatValue}" Text="–"/>
                                <TextBlock x:Name="LoadDownSub" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LoadLabelUp" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="LoadUp" Style="{StaticResource StatValue}" Text="–"/>
                                <TextBlock x:Name="LoadUpSub" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                            <TextBlock x:Name="LoadGrade" Grid.Column="3" FontSize="44" FontWeight="Light" Foreground="{StaticResource Muted}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="LoadVerdict" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

                <!-- MTU + Reparatur -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="MtuTitle" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="MtuDesc" Style="{StaticResource CardDesc}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="MtuRun" Style="{StaticResource Action}" Click="MtuRun_Click"/>
                                <Button x:Name="MtuApply" Style="{StaticResource Action}" Click="MtuApply_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock x:Name="MtuStatus" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="RepairTitle" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="RepairDesc" Style="{StaticResource CardDesc}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="RepairFlush" Style="{StaticResource Action}" Click="RepairFlush_Click"/>
                                <Button x:Name="RepairWinsock" Style="{StaticResource Action}" Click="RepairWinsock_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="RepairStatus" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- System & Komfort -->
                <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="20,16,20,8">
                    <StackPanel>
                        <TextBlock x:Name="SystemTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <ItemsControl x:Name="SysListLeft" ItemTemplate="{StaticResource RowTemplate}" Margin="0,0,24,0" Focusable="False"/>
                            <ItemsControl x:Name="SysListRight" ItemTemplate="{StaticResource RowTemplate}" Margin="24,0,0,0" Focusable="False"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ================= Seite 3: Retrac ================= -->
        <Grid x:Name="PageRetrac" Grid.Row="1" Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PageRetracTrans" Y="0"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,-12,0">
                <StackPanel Margin="0,0,12,0">
                    <!-- Status -->
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Padding="12,7" CornerRadius="10" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ChipLauncherDot" Style="{StaticResource PulsingDot}" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChipLauncherText" Margin="8,0,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,7" CornerRadius="10" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ChipGameDot" Style="{StaticResource PulsingDot}" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChipGameText" Margin="8,0,0,0" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,7" CornerRadius="10" Margin="0,0,8,8">
                            <TextBlock x:Name="ChipBuildText" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </Border>
                    </WrapPanel>

                    <!-- Spielserver -->
                    <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ServerTitle" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="ServerDesc" Style="{StaticResource CardDesc}"/>
                            <TextBlock x:Name="ServerAddr" Margin="0,14,0,0" FontSize="26" FontWeight="Light"
                                       FontFamily="Cascadia Mono, Consolas"/>
                            <TextBlock x:Name="ServerName" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ServerStats" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="ServerFind" Style="{StaticResource Action}" Click="ServerFind_Click"/>
                                <Button x:Name="ServerUse" Style="{StaticResource Action}" Click="ServerUse_Click" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Regionen -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="OgRegionTitle" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="OgRegionDesc" Style="{StaticResource CardDesc}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="OgRegionRun" Style="{StaticResource Action}" Click="OgRegionRun_Click"/>
                                <TextBlock x:Name="OgRegionStatus" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl x:Name="OgRegionList" ItemTemplate="{StaticResource BarRowTemplate}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,22,22,18" CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Button x:Name="RetracBoostButton" Style="{StaticResource BoostButton}" Click="RetracBoost_Click"/>
                        <TextBlock x:Name="RetracHint" Foreground="{StaticResource Muted}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,14,-8,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="RetracRowList" Margin="0,0,8,0" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                    </ScrollViewer>
                    <TextBlock x:Name="RetracNote" Grid.Row="2" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Popups ===== -->
        <Popup x:Name="TargetPopup" PlacementTarget="{Binding ElementName=TargetButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="2">
            <Border Margin="16" Width="300" Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}"
                    BorderThickness="1" CornerRadius="14" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <ListBox x:Name="TargetList" Style="{StaticResource PopupList}" MaxHeight="320"
                             ItemTemplate="{StaticResource TargetItem}" SelectionChanged="TargetList_SelectionChanged"/>
                    <Border Height="1" Background="{StaticResource Line}" Margin="6,8"/>
                    <Grid>
                        <TextBox x:Name="CustomBox" Style="{StaticResource PopupBox}" KeyDown="CustomBox_KeyDown"/>
                        <TextBlock x:Name="CustomHint" IsHitTestVisible="False" Foreground="{StaticResource Muted}"
                                   Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="GamePopup" Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Margin="12" Width="320" Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}"
                    BorderThickness="1" CornerRadius="14" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="GameHeader" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,6,10,8" TextWrapping="Wrap"/>
                    <ListBox x:Name="GameList" Style="{StaticResource PopupList}" MaxHeight="260"
                             ItemTemplate="{StaticResource GameItem}" SelectionChanged="GameList_SelectionChanged"/>
                    <Border Height="1" Background="{StaticResource Line}" Margin="6,8"/>
                    <Button x:Name="BrowseButton" Style="{StaticResource Ghost}" Foreground="{StaticResource Text}"
                            HorizontalContentAlignment="Left" Click="Browse_Click"/>
                    <Button x:Name="ClearGameButton" Style="{StaticResource Ghost}" Click="ClearGame_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="PotatoPopup" Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Margin="12" Width="330" Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}"
                    BorderThickness="1" CornerRadius="14" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="PotatoHeader" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,6,10,8" TextWrapping="Wrap"/>
                    <ListBox x:Name="PotatoList" Style="{StaticResource PopupList}"
                             ItemTemplate="{StaticResource PotatoItem}"/>
                </StackPanel>
            </Border>
        </Popup>
        </Grid>

        <!-- ================= Auto-Updater Modal ================= -->
        <Grid x:Name="UpdateModal" Visibility="Collapsed" Panel.ZIndex="1000" Background="#9905070A" MouseLeftButtonDown="UpdateModal_BackgroundClick">
            <Border Width="500" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="18" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.65" Color="#000000"/>
                </Border.Effect>
                <Grid MouseLeftButtonDown="UpdateModal_DialogClick">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header -->
                        <RowDefinition Height="Auto"/> <!-- 1: Divider -->
                        <RowDefinition Height="Auto"/> <!-- 2: Status Header -->
                        <RowDefinition Height="*"/>    <!-- 3: Changelog ScrollViewer -->
                        <RowDefinition Height="Auto"/> <!-- 4: GitHub Repo Row -->
                        <RowDefinition Height="Auto"/> <!-- 5: Progress Panel -->
                        <RowDefinition Height="Auto"/> <!-- 6: Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="🚀" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ModalTitle" Text="Auto-Updater" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="ModalSubtitle" Text="Retrac Boost Versionen &amp; Neuerungen" FontSize="12" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="✕" FontSize="14" Width="30" Height="30" Click="UpdateClose_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource Line}" Margin="0,0,0,12"/>

                    <!-- Modal Body / Content -->
                    <TextBlock Grid.Row="2" x:Name="ModalStatusHeader" Text="Aktueller Status" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>

                    <!-- Scrollable Changelog Box -->
                    <Border Grid.Row="3" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" MaxHeight="170">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ModalChangelog" Text="Du verwendest bereits die neueste Version (v1.0.1) mit Frankfurt Best-Server-Lock und ultimativem FPS-Booster."
                                       FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="17"/>
                        </ScrollViewer>
                    </Border>

                    <!-- GitHub Repository Row -->
                    <Border Grid.Row="4" Background="#0D111A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GitHub Repo:" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtGitHubRepo" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}" FontSize="12"
                                     VerticalContentAlignment="Center" Text="muzikadritri/RetracBoost"/>
                            <Button x:Name="BtnOpenGitHub" Grid.Column="2" Style="{StaticResource Ghost}" Content="Releases ↗" FontSize="11.5" Margin="8,0,0,0" Click="OpenGitHub_Click"/>
                        </Grid>
                    </Border>

                    <!-- Download Progress Bar (visible during update) -->
                    <StackPanel Grid.Row="5" x:Name="ModalProgressPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Herunterladen &amp; Installieren..." FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="ModalProgressPercent" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="ModalProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Style="{StaticResource Bar}" Foreground="{StaticResource Accent}"/>
                    </StackPanel>

                    <!-- Action Buttons (Pinned permanently at bottom) -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ModalCheckBtn" Style="{StaticResource Action}" Content="Nach Updates suchen" Margin="0,0,8,0" Click="UpdateCheckNow_Click"/>
                        <Button x:Name="ModalActionBtn" Style="{StaticResource Action}" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Content="Schließen" Click="UpdateClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
